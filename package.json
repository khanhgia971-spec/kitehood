{
  "name": "kitehood",
  "version": "1.0.0",
  "private": true,
  "description": "KiteHood \u2013 Online IDE (Cloudflare Workers)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @kitehood/web",
    "build": "npm run build -w @kitehood/web",
    "build:web": "npm run build -w @kitehood/web",
    "cf:build": "npm run build -w @kitehood/web",
    "deploy": "npm run build:web && npx wrangler deploy",
    "pages:build": "npm run build -w @kitehood/web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.52.0",
    "zustand": "^5.0.0",
    "immer": "^10.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.447.0",
    "framer-motion": "^11.11.1",
    "date-fns": "^4.1.0",
    "uuid": "^10.0.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "wrangler": "^3.78.0",
    "@cloudflare/workers-types": "^4.20241022.0"
  }
}
